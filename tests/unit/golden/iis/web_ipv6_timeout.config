<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by `fairyfly mcp iis setup`. Manual edits are reported as drift by `mcp iis status`. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="fairyfly-strip-spoofed-headers" stopProcessing="false">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="" />
            <set name="HTTP_X_FORWARDED_PROTO" value="" />
            <set name="HTTP_X_FORWARDED_HOST" value="" />
            <set name="HTTP_X_FAIRYFLY_PROXY_SECRET" value="" />
            <set name="HTTP_X_REAL_IP" value="" />
            <set name="HTTP_FORWARDED" value="" />
          </serverVariables>
          <action type="None" />
        </rule>
        <rule name="fairyfly-mcp" stopProcessing="true">
          <match url="^mcp/?$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FAIRYFLY_PROXY_SECRET" value="TESTSECRET" />
            <set name="HTTP_ACCEPT_ENCODING" value="" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:9000/mcp" appendQueryString="true" />
        </rule>
        <rule name="fairyfly-deny-everything-else" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <proxy enabled="true" timeout="00:10:00" responseBufferLimit="0" reverseRewriteHostInResponseHeaders="false" />
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="524288" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
      <ipSecurity allowUnlisted="false" enableReverseDns="false">
        <add ipAddress="203.0.113.0" subnetMask="255.255.255.0" allowed="true" />
        <add ipAddress="2001:db8::/32" allowed="true" />
        <add ipAddress="::1" allowed="true" />
      </ipSecurity>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=0" />
      </customHeaders>
    </httpProtocol>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <directoryBrowse enabled="false" />
    <defaultDocument enabled="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
