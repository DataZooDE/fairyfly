// Version information of fairyfly.exe (configured by CMake: configure_file, @VAR@ placeholders).
// Product name = project name and a product version that is consistent across builds (needed by most signing services).
// The 4th binary field is the same-day release N of YYYY.MM.DD.N (0 for the day's first release).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @FAIRYFLY_VER_MAJOR@,@FAIRYFLY_VER_MINOR@,@FAIRYFLY_VER_PATCH@,@FAIRYFLY_VER_TWEAK@
 PRODUCTVERSION  @FAIRYFLY_VER_MAJOR@,@FAIRYFLY_VER_MINOR@,@FAIRYFLY_VER_PATCH@,@FAIRYFLY_VER_TWEAK@
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "DataZoo GmbH"
            VALUE "FileDescription",  "@FAIRYFLY_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@FAIRYFLY_VERSION_STRING@"
            VALUE "InternalName",     "@FAIRYFLY_RC_NAME@"
            VALUE "LegalCopyright",   "Copyright (c) 2025-2026 DataZoo GmbH. Business Source License 1.1."
            VALUE "OriginalFilename", "@FAIRYFLY_RC_NAME@.exe"
            VALUE "ProductName",      "fairyfly"
            VALUE "ProductVersion",   "@FAIRYFLY_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
