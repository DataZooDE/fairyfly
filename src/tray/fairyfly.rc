#include "tray_resource.h"

// The first icon resource (lowest id) is the executable icon. Sources: assets/logo, generated by assets/generate_icons.py.
IDI_APP                ICON "../../assets/icons/fairyfly.ico"

// Tray icons: the mark in the tray's colour (MCP violet, link teal), a badge per state; *_dark for a dark taskbar,
// *_light for a light one.
IDI_TRAY_RUNNING       ICON "../../assets/icons/tray_mcp_running_dark.ico"
IDI_TRAY_WARNING       ICON "../../assets/icons/tray_mcp_warning_dark.ico"
IDI_TRAY_STOPPED       ICON "../../assets/icons/tray_mcp_stopped_dark.ico"
IDI_TRAY_ERROR         ICON "../../assets/icons/tray_mcp_error_dark.ico"
IDI_TRAY_RUNNING_LIGHT ICON "../../assets/icons/tray_mcp_running_light.ico"
IDI_TRAY_WARNING_LIGHT ICON "../../assets/icons/tray_mcp_warning_light.ico"
IDI_TRAY_STOPPED_LIGHT ICON "../../assets/icons/tray_mcp_stopped_light.ico"
IDI_TRAY_ERROR_LIGHT   ICON "../../assets/icons/tray_mcp_error_light.ico"
IDI_LINK_RUNNING       ICON "../../assets/icons/tray_link_running_dark.ico"
IDI_LINK_WARNING       ICON "../../assets/icons/tray_link_warning_dark.ico"
IDI_LINK_STOPPED       ICON "../../assets/icons/tray_link_stopped_dark.ico"
IDI_LINK_ERROR         ICON "../../assets/icons/tray_link_error_dark.ico"
IDI_LINK_RUNNING_LIGHT ICON "../../assets/icons/tray_link_running_light.ico"
IDI_LINK_WARNING_LIGHT ICON "../../assets/icons/tray_link_warning_light.ico"
IDI_LINK_STOPPED_LIGHT ICON "../../assets/icons/tray_link_stopped_light.ico"
IDI_LINK_ERROR_LIGHT   ICON "../../assets/icons/tray_link_error_light.ico"
