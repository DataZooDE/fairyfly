#include "tray_resource.h"

// The first icon resource (lowest id) is the executable icon. Sources: assets/logo, generated by assets/generate_icons.py.
IDI_APP                ICON "../../assets/icons/fairyfly.ico"

// Tray icons: whole mark recoloured per server state; *_DARK for a dark taskbar, *_LIGHT for a light one.
IDI_TRAY_RUNNING       ICON "../../assets/icons/tray_running_dark.ico"
IDI_TRAY_WARNING       ICON "../../assets/icons/tray_warning_dark.ico"
IDI_TRAY_STOPPED       ICON "../../assets/icons/tray_stopped_dark.ico"
IDI_TRAY_ERROR         ICON "../../assets/icons/tray_error_dark.ico"
IDI_TRAY_RUNNING_LIGHT ICON "../../assets/icons/tray_running_light.ico"
IDI_TRAY_WARNING_LIGHT ICON "../../assets/icons/tray_warning_light.ico"
IDI_TRAY_STOPPED_LIGHT ICON "../../assets/icons/tray_stopped_light.ico"
IDI_TRAY_ERROR_LIGHT   ICON "../../assets/icons/tray_error_light.ico"
