<!--
  Per-user installer of fairyfly (D10 install and update), built with WiX v5:
    wix build packaging/fairyfly.wxs -arch x64 -d ExePath=build/Release/fairyfly.exe -d TrayExePath=build/Release/fairyfly-tray.exe -d MsiVersion=26.10.5 -o fairyfly.msi
  - Installs fairyfly.exe to %LOCALAPPDATA%\Programs\fairyfly without administrator rights (the tray, the link and
    SAP GUI all run as the user on the interactive desktop).
  - Appends that folder to the user's PATH and adds the Start-menu entry "fairyfly": the cloud link tray
    (fairyfly link run with the tray option; unpaired it leads to pairing, its menu can start the local MCP server
    tray). The entry starts fairyfly-tray.exe, a Windows-subsystem starter, so no console window flashes.
  - Before it replaces or removes the files it ends this installation's running fairyfly (fairyfly-tray.exe close
    option, the copy carried in this MSI's Binary table, with the install folder): the trays are asked to quit as from
    their menu, what still runs after 10 s is terminated; a Microsoft Store fairyfly.exe is not touched. An uninstall
    also removes the trays' Run values and settings. After an interactive install (not with /qn or
    /quiet) it starts the tray; LAUNCHAPP=0 turns that off. Up to 2026.10.23 the entry was "fairyfly (tray)" (the MCP tray without the HTTP option, which exits at
    once); it lives in
    the same component, so an upgrade (MajorUpgrade removes the old product first) replaces it.
  - MsiVersion: Windows Installer compares major.minor.build only (major < 256, build < 65536), so the calendar version
    YYYY.MM.DD[.N] becomes (YYYY-2000).MM.(DD*100+N): 2026.10.05 -> 26.10.500, a further release on the same day
    2026.10.24.1 -> 26.10.2401 (packaging/msi_version.ps1). It replaces 26.10.2400, and 26.10.2400 is refused over it
    (downgrade). Up to 2026.10.24.1 the MSIs were 26.10.DD[.N] (N ignored): all are below the new scheme
    (CI: winget.yml chain, from the released v2026.10.24.1 MSI).
  - Upgrades replace older versions (MajorUpgrade, same UpgradeCode); `fairyfly update apply` may also update the exe
    in place between MSI releases.
  - Software distribution: deploy the MSI per user (e.g. Intune "user" context); it never writes HKLM.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="fairyfly" Manufacturer="DataZoo GmbH" Version="$(var.MsiVersion)"
           UpgradeCode="{AEC9807E-BC74-4802-8816-25F3AB39BA29}" Scope="perUser" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="fairyfly - SAP GUI automation CLI, MCP server and cloud link" />
    <!-- AllowSameVersionUpgrades: a rebuilt MSI of the same version (a new ProductCode per build) replaces the
         installed one instead of being installed beside it (ICE61 warns about it; that is intended). Same-day releases
         differ in the third field (DD*100+N), so an older one is refused as a downgrade. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of fairyfly is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- 1: start the tray after an interactive install or upgrade (silent installs never start it) -->
    <Property Id="LAUNCHAPP" Value="1" Secure="yes" />
    <!-- the trays and `fairyfly mcp` hold fairyfly.exe open: they end first, so no reboot is needed and nothing keeps
         running from removed files (live 2026-10-29: the link tray of an uninstalled MSI kept the single-instance
         guard and the Microsoft Store tray could not start). This MSI's own starter does it, not the installed one: on
         an upgrade that is the old version's, and on a first install there is none. It runs from a temporary copy, so
         it is given the folder ([INSTALLFOLDER] ends in a backslash; the added one makes that pair one backslash before
         the closing quote, not an escaped quote) and ends only
         fairyfly.exe and fairyfly-tray.exe started from there (src/include/tray/tray_close.h). Not util:CloseApplication:
         that finds processes by file name only and would also end the Store package's fairyfly.exe.
         packaging/tests/Test-WxsClose.ps1 checks this. -->
    <Binary Id="TrayStarter" SourceFile="$(var.TrayExePath)" />
    <CustomAction Id="CloseTrays" BinaryRef="TrayStarter" ExeCommand="--close &quot;[INSTALLFOLDER]\&quot;"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="UninstallCleanup" BinaryRef="TrayStarter" ExeCommand="--uninstall &quot;[INSTALLFOLDER]\&quot;"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="LaunchTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]fairyfly-tray.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <!-- install and major upgrade (the new product is not installed yet); not a repair or modify, which replaces no
         file of the same version and, silent, would leave the trays closed -->
      <Custom Action="CloseTrays" Before="InstallValidate" Condition="NOT Installed" />
      <Custom Action="UninstallCleanup" Before="InstallValidate" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT REMOVE AND LAUNCHAPP=&quot;1&quot; AND UILevel &gt;= 3" />
    </InstallExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="fairyfly" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Main">
      <!-- files in the user profile: the key path is an HKCU value (ICE38), folders are removed on uninstall (ICE64) -->
      <Component Id="FairyflyExe" Directory="INSTALLFOLDER" Guid="{3F7B6A15-2C4E-4D7B-9E1A-8B5C6D7E8F90}">
        <File Id="FairyflyExeFile" Source="$(var.ExePath)" Name="fairyfly.exe" KeyPath="no" />
        <File Id="FairyflyTrayExeFile" Source="$(var.TrayExePath)" Name="fairyfly-tray.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\DataZoo\fairyfly" Name="installed" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="TrayShortcut" Directory="ProgramMenuFolder" Guid="{8D2E4F61-7A3B-4C9D-B1E2-F3A4B5C6D7E8}">
        <Shortcut Id="TrayShortcutLnk" Name="fairyfly" Description="fairyfly cloud link in the system tray (pairing, local MCP server from its menu)"
                  Target="[INSTALLFOLDER]fairyfly-tray.exe" Arguments="link run --tray" WorkingDirectory="INSTALLFOLDER">
          <!-- the approval notifications: fairyfly's AppUserModelID and the COM class that answers them from the
               notification centre (src/include/link/desktop_approval_win32.h) -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="DataZoo.fairyfly" />
          <ShortcutProperty Key="System.AppUserModel.ToastActivatorCLSID" Value="{DAAF1065-EF17-4CFF-B3D2-EFAF70594959}" />
        </Shortcut>
        <!-- the entry up to 2026.10.23; a MajorUpgrade removes it anyway, this also covers a repair or reinstall -->
        <RemoveFile Id="RemoveOldTrayLnk" Name="fairyfly (tray).lnk" On="install" />
        <RegistryValue Root="HKCU" Key="Software\DataZoo\fairyfly" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="fairyfly">
      <ComponentGroupRef Id="Main" />
    </Feature>
  </Package>
</Wix>
