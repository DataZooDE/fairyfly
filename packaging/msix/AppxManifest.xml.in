<?xml version="1.0" encoding="utf-8"?>
<!--
  fairyfly's MSIX package manifest (Microsoft Store), rendered by CMake for FAIRYFLY_PACKAGE=msix into
  <build>/msix/AppxManifest.xml (cmake/msix_manifest.cmake; checked by packaging/msix/tests/Test-AppxManifest.ps1).
  The identity (Identity Name, Publisher, PublisherDisplayName) comes from Partner Center, "Product identity", through
  the CMake cache variables FAIRYFLY_MSIX_IDENTITY_NAME, FAIRYFLY_MSIX_PUBLISHER and FAIRYFLY_MSIX_PUBLISHER_DISPLAY_NAME,
  whose defaults are fairyfly's identity (cmake/msix_manifest.cmake). The version is the calendar version as
  YYYY.MM.(DD*100+N).0.
  The Assets\ images are packaging/msix/Assets (assets/generate_icons.py); packaging/msix/New-MsixLayout.ps1 stages
  them with the MSI's files (packaging/fairyfly.wxs) for MakeAppx (packaging/msix/tests/Test-MsixLayout.ps1).

  - Tray: fairyfly-tray.exe without arguments starts "fairyfly link run" in its tray, as the MSI's Start-menu entry does.
    Its StartupTask replaces the MSI's HKCU Run value "fairyfly-link" (the MSIX build writes no Run value).
  - Cli: fairyfly.exe, no Start-menu tile; the execution alias puts fairyfly.exe on the PATH of every terminal
    (%LOCALAPPDATA%\Microsoft\WindowsApps), which is also what `fairyfly mcp client-config` stdio snippets start.
  - The approval notifications: the toast activator COM class (src/link/desktop_approval_win32.cpp,
    src/include/tray/tray_contract.h) is declared here, because HKCU registrations made at run time stay in the
    package's private registry hive.
  - fairyfly's data (audit trail, logs, mcp.yaml, link state, `mcp setup` plan files) is in %USERPROFILE%\.fairyfly
    (docs/DATA_DIR.md), outside AppData, so it is not virtualized on any Windows version: other programs (Explorer,
    editors, the elevated `mcp setup` step, an admin collecting the audit trail) see it, and it survives an uninstall
    like the MSI's. No ExcludedDirectories (Windows 11 only) and no restricted capability unvirtualizedResources.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 com rescap">

  <Identity
    Name="@FAIRYFLY_MSIX_IDENTITY_NAME@"
    Publisher="@FAIRYFLY_MSIX_PUBLISHER@"
    Version="@FAIRYFLY_MSIX_VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>fairyfly</DisplayName>
    <PublisherDisplayName>@FAIRYFLY_MSIX_PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>SAP GUI automation for AI agents: CLI, local MCP server and the fairyfly cloud link</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Tray" Executable="fairyfly-tray.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="fairyfly"
        Description="fairyfly cloud link in the system tray (pairing, local MCP server from its menu)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="fairyfly-tray.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="fairyflyLinkTray" Enabled="true" DisplayName="fairyfly cloud link" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="fairyfly-tray.exe" Arguments="-Embedding" DisplayName="fairyfly approvals">
              <com:Class Id="17C79966-EDD0-4906-9F80-49A822C45334" DisplayName="fairyfly approval notifications" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="17C79966-EDD0-4906-9F80-49A822C45334" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <Application Id="Cli" Executable="fairyfly.exe" EntryPoint="Windows.FullTrustApplication"
                 desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="fairyfly CLI"
        Description="fairyfly command line and MCP server"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="fairyfly.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="fairyfly.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
